# Anthropic
ANTHROPIC_API_KEY=sk-ant...

# Resend (email delivery)
RESEND_API_KEY=re_...
FROM_EMAIL=briefings@yourdomain.com
FROM_NAME=FinCompliance Monitor

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...       # e.g. $49/mo
STRIPE_PRICE_ID_PRO=price_...         # e.g. $149/mo

# App
PORT=3000
APP_URL=https://yourdomain.com
DB_PATH=./compliance.db
NODE_ENV=production

# Set to "true" only when running behind a reverse proxy (nginx, Caddy, etc.)
# that sets X-Forwarded-For. Leaving unset disables proxy trust.
TRUST_PROXY=

# Admin API — required to access /admin/stats (use a strong random secret)
ADMIN_SECRET_KEY=

# NVD API (free, get one at https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Newsletter schedule (cron syntax — default: 7am every Monday, Wednesday, Friday)
CRON_SCHEDULE=0 7 * * 1,3,5
